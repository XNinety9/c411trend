#!/usr/bin/python3
"""Fetch the logged-in user's upload/download/ratio from C411 and log a sample.

The session cookie is read straight from a browser's cookie store (Chromium
family: decrypted with the key from the Secret Service; Firefox family: plain
SQLite), or from a file the user pasted it into. It is handed to curl on stdin,
never on the command line, and is never printed.

With --browser auto (the default) the store that worked last time is tried
first, then the desktop's default browser, then every other known browser,
native, Flatpak or Snap, until one holds a live c411.org session.

Prints one JSON object on stdout:
  {"ok": true,  "sample": {...}, "user": {...}, "source": {...}}
  {"ok": false, "error": "<kind>", "message": "<human text>"}
Error kinds: no-browser, no-cookie, keyring, crypto, expired, network, bad-response.
"""

import argparse
import fcntl
import hashlib
import json
import math
import select
import os
import re
import shutil
import signal
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time

HOST = "c411.org"
API = "https://c411.org/api/auth/me"
UA = "C411Trend (+omarchy plugin)"
# Auto mode stops asking the tracker after this many stale sessions.
MAX_API_ATTEMPTS = 3
# The API answers a few hundred bytes; anything past this is not the API.
MAX_RESPONSE_BYTES = 1024 * 1024
MAX_COOKIE_HEADER = 8192
# Whole run, keyring prompts and every store included.
DEFAULT_DEADLINE = 90
# RFC 6265: cookie-name is a token, cookie-value is cookie-octets (optionally
# DQUOTEd). Anything else - CR/LF above all - never reaches curl's config.
COOKIE_NAME = re.compile(r"^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$")
COOKIE_VALUE = re.compile(r'^"?[\x21\x23-\x2B\x2D-\x3A\x3C-\x5B\x5D-\x7E]*"?$')
# History: rewrite once the file passes this size, keeping every sample of the
# last RECENT_DAYS and one per THIN_SECONDS before that.
COMPACT_BYTES = 2 * 1024 * 1024
RECENT_DAYS = 90
THIN_SECONDS = 6 * 3600
# Seconds between 1601-01-01 (Chromium's epoch) and 1970-01-01.
CHROMIUM_EPOCH_OFFSET = 11644473600

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "c411trend")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "c411trend")
HISTORY = os.path.join(STATE_DIR, "history.jsonl")
LAST_SOURCE = os.path.join(STATE_DIR, "source")
COOKIE_FILE = os.path.join(CONFIG_DIR, "cookie")

